              "event_id",
              "kind",
              "ts"
            ]
          }
        },
        "agent": {
          "anyOf": [
            {
              "$ref": "#/$defs/agent_decision"
            },
            {
              "type": "null"
            }
          ]
        },
        "trace": {
          "anyOf": [
            {
              "$ref": "#/$defs/trace"
            },
            {
              "type": "null"
            }
          ]
        },
        "evals": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/eval_score"
          }
        },
        "links": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/link"
          }
        }
      }
    }
  }
