# ────────────────────────────────────────────────────────────────────────────
# Sentinel (backend) — environment
# Canonical reference; mirrored to the repo root `.env.example`. Copy to `.env`
# (gitignored) and fill. In production these arrive as a K8s Secret synced from
# Key Vault at deploy time (sentinel §8.2). Reconstructed from sentinel
# ARCHITECTURE.md §4.7, §8.2, §13.2. Supersedes the Phase-1 Groq-based file.
# ────────────────────────────────────────────────────────────────────────────

# ── LLM providers (sentinel §4.7 — Anthropic default, OpenAI fallback) ─────────
SENTINEL_PRIMARY_PROVIDER=anthropic      # 'anthropic' | 'openai'
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...                     # always required (fallback)

# ── Database (Azure PostgreSQL B1MS + pgvector; local: pgvector/pgvector:pg16) ──
# rev-5: Azure Postgres is **Entra-only** (password_auth_enabled=false). There is no stored
# DB password — the backend gets a short-lived Entra token via AKS workload identity and
# presents it as the password (audience https://ossrdbms-aad.database.windows.net).
# So set host/user/db here and let the app mint the token at connect time.
PGHOST=sentinel-pg.postgres.database.azure.com
PGDATABASE=sentinel
PGUSER=                                   # the backend UAMI's DB principal name (infra §3.2)
PGSSLMODE=require
# Local dev only — plain password auth against a local container:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sentinel

# ── LangFuse (tracing, prompt mgmt, scoring — sentinel §6) ─────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Datadog (fetch_logs tool — sentinel §4.8) ──────────────────────────────────
DD_API_KEY=
DD_APP_KEY=
DD_SITE=datadoghq.com

# ── GitHub API (get_deploy_details / PR details — sentinel §4.8) ───────────────
GITHUB_API_TOKEN=                         # `repo` read scope on sentinel-deployment

# ── Backend API auth (sentinel §3.6 — Entra bearer on all non-health routes) ───
# rev-5: the shared X-Sentinel-Token / SENTINEL_API_TOKEN is GONE. Callers send
# `Authorization: Bearer <Entra token>` scoped to the audience below; the backend validates
# it against Entra JWKS (iss/aud/exp + the Incident.Write app role). Both values are public
# config (GitHub *variables*), not secrets. /health + /ready stay open for K8s probes.
SENTINEL_API_AUDIENCE=api://sentinel-backend
AZURE_TENANT_ID=                          # az account show --query tenantId -o tsv

# ── Runtime config (sentinel §4.6, §13.2) ──────────────────────────────────────
SENTINEL_LOG_LEVEL=INFO
SENTINEL_MAX_TOOL_CALLS=20                 # raised from 15 for reflexion loops
SENTINEL_EMBEDDING_MODEL=all-MiniLM-L6-v2  # local, 384-dim, zero-cost
SENTINEL_DB_POOL_MIN=2
SENTINEL_DB_POOL_MAX=10

# ── Testing / CI (sentinel §9.1) ───────────────────────────────────────────────
# SENTINEL_FAKE_LLM=1                      # stub provider calls; /ready skips live-provider check
