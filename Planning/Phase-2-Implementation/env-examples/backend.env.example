# ────────────────────────────────────────────────────────────────────────────
# Sentinel (backend) — environment
# Canonical reference; mirrored to the repo root `.env.example`. Copy to `.env`
# (gitignored) and fill. In production these arrive as a K8s Secret synced from
# Key Vault at deploy time (sentinel §8.2). Reconstructed from sentinel
# ARCHITECTURE.md §4.7, §8.2, §13.2. Supersedes the Phase-1 Groq-based file.
# ────────────────────────────────────────────────────────────────────────────

# ── LLM providers (sentinel §4.7 — Anthropic default, OpenAI fallback) ─────────
SENTINEL_PRIMARY_PROVIDER=anthropic      # 'anthropic' | 'openai'
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...                     # always required (fallback)

# ── Database (Azure PostgreSQL B1MS + pgvector; local: pgvector/pgvector:pg16) ──
DATABASE_URL=postgresql://sentinel_admin:CHANGEME@sentinel-pg.postgres.database.azure.com/sentinel
# Local dev: postgresql://postgres:postgres@localhost:5432/sentinel

# ── LangFuse (tracing, prompt mgmt, scoring — sentinel §6) ─────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Datadog (fetch_logs tool — sentinel §4.8) ──────────────────────────────────
DD_API_KEY=
DD_APP_KEY=
DD_SITE=datadoghq.com

# ── GitHub API (get_deploy_details / PR details — sentinel §4.8) ───────────────
GITHUB_API_TOKEN=                         # `repo` read scope on sentinel-deployment

# ── Backend API auth (sentinel §3 — X-Sentinel-Token on all non-health routes) ──
SENTINEL_API_TOKEN=                       # openssl rand -hex 32

# ── Runtime config (sentinel §4.6, §13.2) ──────────────────────────────────────
SENTINEL_LOG_LEVEL=INFO
SENTINEL_MAX_TOOL_CALLS=20                 # raised from 15 for reflexion loops
SENTINEL_EMBEDDING_MODEL=all-MiniLM-L6-v2  # local, 384-dim, zero-cost
SENTINEL_DB_POOL_MIN=2
SENTINEL_DB_POOL_MAX=10

# ── Testing / CI (sentinel §9.1) ───────────────────────────────────────────────
# SENTINEL_FAKE_LLM=1                      # stub provider calls; /ready skips live-provider check
