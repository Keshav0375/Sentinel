# ────────────────────────────────────────────────────────────────────────────
# Sentinel-infra — environment (Terraform)
# Copy to the Sentinel-infra repo as `.env` (gitignored). Values here drive
# `terraform` locally; in CI the same values are GitHub secrets (infra §9) and
# Azure auth is OIDC (no client secret). Reconstructed from sentinel-infra
# ARCHITECTURE.md §4, §5, §8, §9, §10.
# ────────────────────────────────────────────────────────────────────────────

# ── Azure identity (OIDC app from the one-time bootstrap, infra §4.3) ──────────
AZURE_SUBSCRIPTION_ID=              # az account show --query id -o tsv
AZURE_TENANT_ID=                    # az account show --query tenantId -o tsv
AZURE_CLIENT_ID=                    # appId of the sentinel-gha-oidc app registration
# For LOCAL `terraform apply` you can instead `az login` interactively and omit
# ARM_* below. For non-interactive local runs, set the ARM_* trio (uses OIDC in CI):
# ARM_SUBSCRIPTION_ID=${AZURE_SUBSCRIPTION_ID}
# ARM_TENANT_ID=${AZURE_TENANT_ID}
# ARM_CLIENT_ID=${AZURE_CLIENT_ID}
# ARM_USE_OIDC=true

# ── Terraform input variables (variables.tf → TF_VAR_*) ────────────────────────
TF_VAR_location=eastus             # region — verify B2ats_v2 + F1 free-tier availability
TF_VAR_resource_group_name=sentinel-rg
TF_VAR_db_password=                # PostgreSQL admin password (you choose; ≥16 chars)
TF_VAR_github_owner=Keshav0375     # NOTE: real owner (arch docs say keshxvDev)
TF_VAR_github_pat=                 # GitHub PAT, `repo` scope — for github_actions_secret + Function bridge

# ── Remote state backend (bootstrapped manually once, infra §8.1) ──────────────
# These match backend.tf; the storage account must already exist.
TF_STATE_RESOURCE_GROUP=sentinel-state-rg
TF_STATE_STORAGE_ACCOUNT=sentineltfstate
TF_STATE_CONTAINER=tfstate
TF_STATE_KEY=sentinel.terraform.tfstate

# ── Runtime secrets to load into Key Vault AFTER apply (infra §10 step 6) ───────
# Not Terraform inputs — set via `az keyvault secret set`. Listed here so you can
# collect them in one place before the bootstrap.
# anthropic-api-key, openai-api-key, dd-api-key, dd-app-key, teams-webhook-url,
# langfuse-secret-key, langfuse-public-key, sentinel-api-token (openssl rand -hex 32)
