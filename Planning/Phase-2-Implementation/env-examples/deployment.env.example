# ────────────────────────────────────────────────────────────────────────────
# Sentinel-deployment — environment (dummy app + deploy pipeline)
# Copy to the Sentinel-deployment repo as `.env` (gitignored). App vars are read
# by app/config.py (AppConfig); pipeline vars are GitHub secrets in CI (deployment
# §3.4). Reconstructed from sentinel-deployment ARCHITECTURE.md §2.4, §3, §8.
# ────────────────────────────────────────────────────────────────────────────

# ── App (local dev — AppConfig, deployment §2.4) ───────────────────────────────
APP_VERSION=local-dev
DD_SERVICE=dummy-api
DD_ENV=dev
PORT=8000

# ── Deploy pipeline (CI: GitHub secrets — documented here for local runs) ──────
# Auto-pushed by sentinel-infra Terraform (github_actions_secret):
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
# Set manually:
DD_API_KEY=                        # Datadog API key
DD_SITE=datadoghq.com              # US1 datadoghq.com | US5 us5.datadoghq.com
DEPLOYED_APP_URL=https://dummy-api.azurewebsites.net
AZURE_RG=sentinel-rg

# DB access for the record-deployment stage uses the OIDC identity's Key Vault read
# role at runtime (no DB secret here). See deployment §3.4.
