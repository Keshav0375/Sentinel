# Sentinel — Environment Variables
# Copy to .env and fill in real values. Never commit .env.

# ── Required ─────────────────────────────────────────────────────────────────

# Primary LLM provider (Groq, OpenAI-compatible API).
# Get a key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# ── Optional ──────────────────────────────────────────────────────────────────

# Gemini backup — used as fallback when Groq is unavailable.
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq API base URL (change to point at a local proxy or different provider).
# Default: https://api.groq.com/openai/v1
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Models ────────────────────────────────────────────────────────────────────

# Fast model — used for triage classification and eval judging.
# Default: llama-3.1-8b-instant
# SENTINEL_TRIAGE_MODEL=llama-3.1-8b-instant

# Capable model — used for log analysis, deploy correlation, remediation.
# Default: llama-3.3-70b-versatile
# SENTINEL_ANALYSIS_MODEL=llama-3.3-70b-versatile

# Judge model for trajectory eval — kept separate to allow cross-family scoring.
# Default: llama-3.1-8b-instant
# SENTINEL_JUDGE_MODEL=llama-3.1-8b-instant

# Local sentence-transformers model for zero-cost embeddings (384 dims).
# Default: all-MiniLM-L6-v2
# SENTINEL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Infrastructure ────────────────────────────────────────────────────────────

# SQLite database path — relative to project root.
# Default: ./data/sentinel.db
# SENTINEL_DB_PATH=./data/sentinel.db

# Structured log level.
# Default: INFO
# SENTINEL_LOG_LEVEL=INFO

# Maximum tool calls allowed per incident before auto-escalation.
# Default: 15
# SENTINEL_MAX_TOOL_CALLS=15
