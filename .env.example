# Sentinel — Environment Variables
# Copy to .env and fill in real values. Never commit .env.
#
# Model strings use the "provider/model" format — change the prefix to switch
# providers without touching code. See available_models.md for all options.

# ── Models ────────────────────────────────────────────────────────────────────

# Fast model — used for triage classification and eval judging.
# Default: groq/llama-3.1-8b-instant
# SENTINEL_TRIAGE_MODEL=groq/llama-3.1-8b-instant

# Capable model — used for log analysis, deploy correlation, remediation.
# Default: groq/llama-3.3-70b-versatile
# SENTINEL_ANALYSIS_MODEL=groq/llama-3.3-70b-versatile

# Judge model for trajectory eval — kept separate to allow cross-family scoring.
# Default: groq/llama-3.1-8b-instant
# SENTINEL_JUDGE_MODEL=groq/llama-3.1-8b-instant

# ── Groq (default provider) ───────────────────────────────────────────────────
# Required — all model defaults use groq/ so this key is always needed unless
# you override every SENTINEL_*_MODEL to a different provider.
# Get a key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Groq API base URL. Change to point at a proxy or local LLM server.
# Default: https://api.groq.com/openai/v1
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Required only when SENTINEL_*_MODEL uses the "openai/" prefix.
# Example: SENTINEL_ANALYSIS_MODEL=openai/gpt-4o
# OPENAI_API_KEY=sk-...

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Required only when SENTINEL_*_MODEL uses the "anthropic/" prefix.
# Example: SENTINEL_ANALYSIS_MODEL=anthropic/claude-sonnet-4-6
# ANTHROPIC_API_KEY=sk-ant-...

# ── Azure OpenAI ──────────────────────────────────────────────────────────────
# Required only when SENTINEL_*_MODEL uses the "azure/" prefix.
# Example: SENTINEL_ANALYSIS_MODEL=azure/my-gpt4o-deployment
# AZURE_API_KEY=...
# AZURE_API_BASE=https://<your-resource>.openai.azure.com/
# AZURE_API_VERSION=2024-02-01


# ── Infrastructure ────────────────────────────────────────────────────────────

# SQLite database path — relative to project root.
# Default: ./data/sentinel.db
# SENTINEL_DB_PATH=./data/sentinel.db

# Structured log level.
# Default: INFO
# SENTINEL_LOG_LEVEL=INFO

# Maximum tool calls allowed per incident before auto-escalation.
# Default: 15
# SENTINEL_MAX_TOOL_CALLS=15

# Local sentence-transformers model for zero-cost embeddings (384 dims).
# Default: all-MiniLM-L6-v2
# SENTINEL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Gemini (excluded from provider layer — future Google ADK plan) ────────────
# GEMINI_API_KEY=
