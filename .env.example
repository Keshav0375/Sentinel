# Sentinel (backend) — Environment Variables
# Copy to .env and fill in real values. Never commit .env.
#
# Phase 2: Anthropic (default) + OpenAI (fallback), Azure PostgreSQL + pgvector,
# LangFuse tracing, Datadog log fetching. In production the pod holds no credentials and
# there is no K8s Secret: keys are read from Key Vault at runtime and PostgreSQL takes an
# Entra token via workload identity (backend architecture §8.2).
# No variable is required to boot: a missing key makes only its feature fail, at use.

# ── LLM providers (§4.7 — Anthropic default, OpenAI fallback) ──────────────────
# Each agent role runs a fixed model pair (§4.7 table); this picks which side runs first.
# The eval judge always runs on the OTHER provider. Models are not configurable.
SENTINEL_PRIMARY_PROVIDER=anthropic        # 'anthropic' | 'openai'
# Read at use, never at boot. A missing primary key falls back to the other provider;
# with neither, an incident escalates.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...                       # fallback path, and the judge while primary=anthropic

# ── Database (PostgreSQL + pgvector) ───────────────────────────────────────────
# Empty → no Postgres pool; the app still boots and memory reports "memory unavailable".
# Set it ONLY to a local/CI pgvector container — a postgres:// DSN that cannot be
# reached makes `sentinel serve` fail at startup. Local dev:
#   docker run -d --name sentinel-pg-test -e POSTGRES_PASSWORD=test \
#     -e POSTGRES_DB=sentinel -p 55432:5432 pgvector/pgvector:pg16
#   DATABASE_URL=postgresql://postgres:test@localhost:55432/sentinel
#   (shape: postgresql://<user>:<password>@<host>:<port>/<database>)
# Then create the schema: poetry run alembic upgrade head (alembic/env.py reads it too).
# The Azure server is Entra-only (no password auth), so there is no password DSN
# for it — the backend connects with an Entra token (workload identity, phase 7).
DATABASE_URL=

# ── LangFuse (tracing, prompt management, scoring — §6) ────────────────────────
# langfuse v3 reads these from the process environment (Settings mirrors them). Either key
# unset or blank → tracing disabled (no-op), prompts load from agents/prompts/*.txt.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com   # v3 name; LANGFUSE_HOST is the deprecated v2 one

# ── Datadog (fetch_logs tool — §4.8) ───────────────────────────────────────────
DD_API_KEY=
# Application key scoped to logs_read_data + synthetics_read.
DD_APP_KEY=
DD_SITE=us5.datadoghq.com

# ── GitHub API (get_deploy_details — §4.8) ─────────────────────────────────────
# Read-only fine-grained PAT on Keshav0375/Sentinel-deployment with only "Pull requests: read"
# (the tool reads GET /repos/{repo}/pulls/{n}; Contents is not used). Unset: no PR enrichment.
GITHUB_API_TOKEN=

# ── Inbound auth: Entra bearer (§3.6) ──────────────────────────────────────────
# Public config, not secrets. Unset → every route except /health and /ready returns 401.
# The IDENTITY tenant GUID holding the backend app registration (not AZURE_TENANT_ID,
# which is the workload-identity/resource tenant). Only v2 tokens are accepted.
SENTINEL_API_TENANT_ID=
# Comma-separated accepted audiences: the API app's client ID (GUID; required — v2 tokens carry aud = it), optionally
# its identifier URI api://<identity_tenant_id>/sentinel-backend-<deployment>-<env>. No default: unset → 401.
SENTINEL_API_AUDIENCE=

# ── Azure runtime access (§8.2) — the pod sets these; leave blank locally ───────
# Key Vault read once at startup (restart the pod to pick up a rotated secret) with DefaultAzureCredential (workload identity in the pod):
# datadog-api-key, datadog-app-key, langfuse-public-key, langfuse-secret-key, langfuse-base-url.
# A vault value overrides the env one; a missing secret is logged, not fatal. LLM keys never come
# from the vault. Blank → env only.
KEY_VAULT_URL=
# Entra-only Azure PostgreSQL, used only when DATABASE_URL is blank (all three or none). The
# password is an Entra token (scope https://ossrdbms-aad.database.windows.net/.default) per connection.
PGHOST=
PGDATABASE=
PGUSER=

# ── Runtime config (§4.6, §13.2) ───────────────────────────────────────────────
SENTINEL_LOG_LEVEL=INFO
SENTINEL_MAX_TOOL_CALLS=20                   # raised from 15 for reflexion loops
SENTINEL_AGENT_RUN_TIMEOUT_S=600             # one agent run, seconds (240-1800; > 183s per-call worst case)
SENTINEL_EMBEDDING_MODEL=all-MiniLM-L6-v2    # local, 384-dim, zero-cost
SENTINEL_DB_POOL_MIN=2
SENTINEL_DB_POOL_MAX=10
SENTINEL_WEBHOOK_MAX_BODY_BYTES=262144             # POST /webhooks/incident body cap (413 over it)
SENTINEL_MAX_CONCURRENT_PIPELINES=5          # in-flight incidents; beyond it POST /webhooks/incident → 429 + Retry-After
SENTINEL_PIPELINE_TIMEOUT_S=900               # one incident's whole pipeline, seconds; past it → escalated "pipeline timeout"
SENTINEL_SHUTDOWN_GRACE_S=20                 # SIGTERM: wait this long for in-flight incidents, then log + cancel (< pod grace 30s)

# ── Testing / CI (§9.1) ────────────────────────────────────────────────────────
# SENTINEL_FAKE_LLM=1                        # stub provider calls; /ready skips live-provider check
# SENTINEL_DEV_OPEN_DASHBOARD=1               # LOCAL ONLY: GET /, /eval + their read APIs without a token (webhook/generate stay protected)
# Tests never read DATABASE_URL or this file. The database tests use TEST_DATABASE_URL,
# set in the shell, and create/drop throwaway databases on that server, so point it only
# at a disposable container. Unset → they skip locally; in CI (CI=true) they fail.
#   TEST_DATABASE_URL=postgresql://postgres:test@localhost:55432/sentinel poetry run pytest
