# Sentinel (backend) — Environment Variables
# Copy to .env and fill in real values. Never commit .env.
#
# Phase 2: Anthropic (default) + OpenAI (fallback), Azure PostgreSQL + pgvector,
# LangFuse tracing, Datadog log fetching. In production the pod holds no credentials and
# there is no K8s Secret: keys are read from Key Vault at runtime and PostgreSQL takes an
# Entra token via workload identity (backend architecture §8.2).
# Canonical copy: Planning/Phase-2-Implementation/env-examples/backend.env.example

# ── LLM providers (§4.7 — Anthropic default, OpenAI fallback) ──────────────────
SENTINEL_PRIMARY_PROVIDER=anthropic        # 'anthropic' | 'openai'
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...                       # always required (fallback path)

# ── Database (PostgreSQL + pgvector) ───────────────────────────────────────────
# Empty → no Postgres pool; the app runs on the Phase-1 SQLite store alone.
# Set it ONLY to a local/CI pgvector container — a postgres:// DSN that cannot be
# reached makes `sentinel serve` fail at startup. Local dev:
#   docker run -d --name sentinel-pg-test -e POSTGRES_PASSWORD=test \
#     -e POSTGRES_DB=sentinel -p 55432:5432 pgvector/pgvector:pg16
#   DATABASE_URL=postgresql://postgres:test@localhost:55432/sentinel
#   (shape: postgresql://<user>:<password>@<host>:<port>/<database>)
# The Azure server is Entra-only (no password auth), so there is no password DSN
# for it — the backend connects with an Entra token (workload identity, phase 7).
DATABASE_URL=

# ── LangFuse (tracing, prompt management, scoring — §6) ────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Datadog (fetch_logs tool — §4.8) ───────────────────────────────────────────
DD_API_KEY=
DD_APP_KEY=
DD_SITE=datadoghq.com

# ── GitHub API (get_deploy_details — §4.8) ─────────────────────────────────────
GITHUB_API_TOKEN=                           # `repo` read scope on sentinel-deployment

# ── Backend API auth (§3 — X-Sentinel-Token on all non-health routes) ──────────
SENTINEL_API_TOKEN=                         # openssl rand -hex 32

# ── Runtime config (§4.6, §13.2) ───────────────────────────────────────────────
SENTINEL_LOG_LEVEL=INFO
SENTINEL_MAX_TOOL_CALLS=20                   # raised from 15 for reflexion loops
SENTINEL_EMBEDDING_MODEL=all-MiniLM-L6-v2    # local, 384-dim, zero-cost
SENTINEL_DB_POOL_MIN=2
SENTINEL_DB_POOL_MAX=10

# ── Testing / CI (§9.1) ────────────────────────────────────────────────────────
# SENTINEL_FAKE_LLM=1                        # stub provider calls; /ready skips live-provider check
